{
  "version": 1,
  "name": "ui-review",
  "purpose": "Content-first UI comparison with isolated fake records; GUI visibility assertions are smoke checks, screenshots require review.",
  "artifact": {
    "path": ".build/maclab/ui-review.tar",
    "format": "tar",
    "app_bundle_path": "WorkLogReview.app",
    "expected_bundle_id": "dev.worklog.UIReview"
  },
  "prepare": [
    {
      "id": "build-before",
      "kind": "exec",
      "purpose": "before SwiftUI build, isolated fixture only",
      "before": "Remote test session available",
      "after": "Inspect exit code and evidence",
      "argv": [
        "/bin/bash",
        "scripts/maclab/build-remote.sh",
        "before"
      ],
      "timeout_seconds": 600
    },
    {
      "id": "build-after",
      "kind": "exec",
      "purpose": "after SwiftUI build, isolated fixture only",
      "before": "Remote test session available",
      "after": "Inspect exit code and evidence",
      "argv": [
        "/bin/bash",
        "scripts/maclab/build-remote.sh",
        "after"
      ],
      "timeout_seconds": 600
    }
  ],
  "cases": [
    {
      "id": "before-layout",
      "purpose": "before screenshots across sizes and routes",
      "steps": [
        {
          "id": "before-launch",
          "kind": "exec",
          "purpose": "Launch before with synthetic data",
          "before": "Remote test session available",
          "after": "Inspect exit code and evidence",
          "argv": [
            "/usr/bin/open",
            "-n",
            "Before.app",
            "--args",
            "--ui-test-fixture",
            "many"
          ],
          "timeout_seconds": 30
        },
        {
          "id": "before-day-1280-open",
          "kind": "osascript",
          "purpose": "day-1280-open",
          "before": "Application is open",
          "after": "Observe actual screen",
          "script": "delay 2\ntell application \"System Events\"\n tell process \"WorkLogApp\"\n  set frontmost to true\n  set position of window 1 to {0, 25}\n  set size of window 1 to {1280, 800}\n end tell\n keystroke \"1\" using command down\nend tell\ndelay 1",
          "timeout_seconds": 30
        },
        {
          "id": "before-day-1280",
          "kind": "screenshot",
          "target": "screen",
          "purpose": "day-1280 UI comparison",
          "before": "Requested screen active",
          "after": "Review captured layout and text"
        },
        {
          "id": "before-day-960-open",
